{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "enum": [
            "X+",
            "X-",
            "Y+",
            "Y-",
            "Z+",
            "Z-"
          ],
          "title": "Axis",
          "type": "string"
        },
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "distance_mm": {
          "exclusiveMinimum": 0,
          "title": "Distance Mm",
          "type": "number"
        },
        "kind": {
          "enum": [
            "REMOVE_FASTENER",
            "TRANSLATE_PART"
          ],
          "title": "Kind",
          "type": "string"
        },
        "tool_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Id"
        }
      },
      "required": [
        "kind",
        "component_id",
        "axis",
        "distance_mm"
      ],
      "title": "Action",
      "type": "object"
    },
    "Certificate": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "assumptions": {
          "default": "Rigid original placements; reusable screw rotation and torque abstracted; identical replacement geometry",
          "title": "Assumptions",
          "type": "string"
        },
        "before_state_hash": {
          "title": "Before State Hash",
          "type": "string"
        },
        "constraint_hash": {
          "title": "Constraint Hash",
          "type": "string"
        },
        "geometry_hash": {
          "title": "Geometry Hash",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "mode": {
          "enum": [
            "removal",
            "insertion"
          ],
          "title": "Mode",
          "type": "string"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/PathResult"
          },
          "title": "Paths",
          "type": "array"
        },
        "policy_hash": {
          "title": "Policy Hash",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "clear",
            "blocked",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "subchecks": {
          "items": {
            "type": "string"
          },
          "title": "Subchecks",
          "type": "array"
        },
        "tool_hash": {
          "title": "Tool Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision_id",
        "input_hash",
        "geometry_hash",
        "constraint_hash",
        "tool_hash",
        "policy_hash",
        "before_state_hash",
        "action",
        "mode",
        "status",
        "paths",
        "subchecks"
      ],
      "title": "Certificate",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "component_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Component Ids",
          "type": "array"
        },
        "distance_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Mm"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "intersection_volume_mm3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intersection Volume Mm3"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "witness_mm": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Witness Mm"
        },
        "witness_travel_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Witness Travel Mm"
        }
      },
      "required": [
        "status",
        "kind",
        "explanation"
      ],
      "title": "Finding",
      "type": "object"
    },
    "PathResult": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "enum": [
            "X+",
            "X-",
            "Y+",
            "Y-",
            "Z+",
            "Z-"
          ],
          "title": "Axis",
          "type": "string"
        },
        "clearance_lower_bound_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clearance Lower Bound Mm"
        },
        "clearance_mm": {
          "title": "Clearance Mm",
          "type": "number"
        },
        "contact_exemptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contact Exemptions",
          "type": "array"
        },
        "coverage_established": {
          "title": "Coverage Established",
          "type": "boolean"
        },
        "distance_mm": {
          "title": "Distance Mm",
          "type": "number"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "geometry_hash": {
          "title": "Geometry Hash",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "moving_occurrence": {
          "title": "Moving Occurrence",
          "type": "string"
        },
        "policy_version": {
          "default": "policy_v1",
          "title": "Policy Version",
          "type": "string"
        },
        "representation": {
          "default": "server_validated_world_aabb_union",
          "title": "Representation",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
      },
      "required": [
        "id",
        "moving_occurrence",
        "axis",
        "distance_mm",
        "status",
        "geometry_hash",
        "input_hash",
        "clearance_mm",
        "coverage_established",
        "findings",
        "explanation"
      ],
      "title": "PathResult",
      "type": "object"
    },
    "Status": {
      "enum": [
        "clear",
        "blocked",
        "unknown",
        "unsupported",
        "invalid_input"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "$id": "urn:unlock:ValidationReport:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "certificates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Certificate"
      },
      "title": "Certificates",
      "type": "array"
    },
    "checked_steps": {
      "default": 0,
      "title": "Checked Steps",
      "type": "integer"
    },
    "connection_restoration": {
      "default": "not_run",
      "title": "Connection Restoration",
      "type": "string"
    },
    "elapsed_ms": {
      "default": 0,
      "title": "Elapsed Ms",
      "type": "number"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "fastener_reinsertion": {
      "default": "not_run",
      "title": "Fastener Reinsertion",
      "type": "string"
    },
    "final_removed_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Final Removed Ids",
      "type": "array"
    },
    "geometric_insertion": {
      "default": "not_run",
      "title": "Geometric Insertion",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "unknown",
        "not_run"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool_access": {
      "default": "not_run",
      "title": "Tool Access",
      "type": "string"
    }
  },
  "required": [
    "status",
    "explanation"
  ],
  "title": "ValidationReport",
  "type": "object"
}