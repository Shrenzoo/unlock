# Backend only. Copy to backend/.env and add your key there.
AI_PROVIDER=meta
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
META_REASONING_EFFORT=medium
# Paid test calls require BOTH this flag and the key. Ordinary pytest is offline.
RUN_META_LIVE_TESTS=0
UNLOCK_AI_REQUEST_TIMEOUT_S=45
UNLOCK_AI_MAX_RETRIES=2
# HTTP coordinator defaults to local execution, one job at a time.
UNLOCK_DATA_DIR=.data
UNLOCK_CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183
# Explicit offline demonstration: AI_PROVIDER=mock (never reported as live Meta).
# Optional prices: set UNLOCK_AI_PRICE_{INPUT,OUTPUT,CACHED_INPUT}_PER_MTOK,
# UNLOCK_AI_PRICE_SOURCE and UNLOCK_AI_PRICE_RETRIEVED_AT after checking your tariff.
